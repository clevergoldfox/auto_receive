{
  "manifest_version": 3,
  "name": "Crowdworks Auto Bid",
  "version": "1.3.0",
  "description": "Monitors a Google Sheet in real time and auto-generates & submits AI bids on Crowdworks.",
  "permissions": ["storage", "tabs", "alarms", "offscreen"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://crowdworks.jp/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crowdworks Auto Bid"
  },
  "content_scripts": [
    {
      "matches": ["https://crowdworks.jp/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
